---
import BaseLayout from "./BaseLayout.astro";
import DesktopNav from "../components/DesktopNav.astro";
import MobileTabBar from "../components/MobileTabBar.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <DesktopNav />
  <main class="site-main">
    <div class="content-card">
      <div class="reading-column">
        <slot />
      </div>
    </div>
  </main>
  <MobileTabBar />
</BaseLayout>

<style>
  /* The sheet runs the full height of the viewport with no gap above or below,
     so the page ground only ever shows down its sides. */
  .site-main {
    display: flex;
    padding: 0;
  }

  .content-card {
    flex: 1;
    min-height: 100vh;
    background: var(--gradient-surface);
    padding-block: var(--space-8)
      calc(var(--space-8) + var(--tap-target-min) + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 768px) {
    .content-card {
      /* Wider than the nav pill (760px); the reading column inside still holds
         the text to a legible measure. */
      max-width: 1180px;
      margin-inline: auto;
      border-inline: var(--border-hairline-width) solid var(--color-hairline);
      box-shadow: var(--shadow-panel);
      /* The desktop nav is position:fixed and reserves no flow space, so the
         sheet's own top padding provides the clearance. */
      padding-block: calc(var(--desktop-nav-height) + var(--space-7)) var(--space-10);
    }
  }
</style>
