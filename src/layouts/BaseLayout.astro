---
import "../styles/global.scss";
import "../styles/components.scss";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Artemii Karapetian — mathematics, alife, ML." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      /*
        GoatCounter, the same account the Fractals page reports to. Built only
        for production so `npm run dev` and `npm run preview` never inflate the
        counts — its script skips localhost on its own, but not building it at
        all is the version that cannot be got wrong.
      */
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://artemkrptn.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { createRippleRunner } from "../lib/ripple";

  /*
    Only genuinely physical surfaces are lit; a table row is not one. The
    current page's segment is excluded too — it is already activated, so
    lighting it on hover offers nothing and muddies the pressed-in look.
  */
  const SURFACES = '.btn, .desktop-nav-segment:not([aria-current="page"])';

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  /*
    A hover effect is meaningless on a touch screen, and building the GL context
    there is pure cost. Gating on hover capability also keeps it off the device
    class that is most sensitive to main-thread work.
  */
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

  let runner: ReturnType<typeof createRippleRunner> = null;
  let built = false;
  let listening = false;

  /*
    Compiling and linking the shader costs ~900ms of blocking main-thread time
    on a throttled CPU. Doing it at load put a single long task in front of
    every visitor for an effect most of them never trigger, so it is deferred
    to the first hover that actually needs it.
  */
  function ensureRunner() {
    if (built) return runner;
    built = true;
    runner = createRippleRunner();
    // The optimistic class comes off if the context or shaders turn out to be
    // unavailable, handing the surfaces back to the CSS sweep.
    if (!runner) document.documentElement.classList.remove("fx-ripple");
    return runner;
  }

  function onEnter(event: Event) {
    const pointer = event as PointerEvent;
    // Captured on document, so this also fires with `document` itself as the
    // target, which has no closest().
    const target = pointer.target;
    if (!(target instanceof Element)) return;
    const host = target.closest<HTMLElement>(SURFACES);
    if (!host) return;
    const active = ensureRunner();
    if (!active) return;
    const rect = host.getBoundingClientRect();
    active.trigger(host, pointer.clientX - rect.left, pointer.clientY - rect.top);
  }

  function enable() {
    if (listening || reduce.matches || !canHover.matches) return;
    listening = true;
    document.documentElement.classList.add("fx-ripple");
    document.addEventListener("pointerenter", onEnter, { capture: true });
  }

  function disable() {
    if (!listening) return;
    listening = false;
    document.removeEventListener("pointerenter", onEnter, { capture: true });
    runner?.destroy();
    runner = null;
    built = false;
    document.documentElement.classList.remove("fx-ripple");
  }

  enable();
  reduce.addEventListener("change", () => (reduce.matches ? disable() : enable()));
  canHover.addEventListener("change", () => (canHover.matches ? enable() : disable()));
</script>
