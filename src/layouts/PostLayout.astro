---
import SiteLayout from "./SiteLayout.astro";
import "../styles/prose.scss";
import "../styles/hn-comments.scss";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  date: Date;
  /** Names the preview card generated at /og/<slug>.png. */
  slug: string;
  /** Hacker News item id; its thread is loaded in as the comment section. */
  hn?: number;
}

const { title, description, date, slug, hn } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<SiteLayout
  title={`${title} — Artemii Karapetian`}
  shareTitle={title}
  description={description}
  image={`/og/${slug}.png`}
  published={date}
>
  <link slot="head" rel="stylesheet" href={withBase("/katex/katex.min.css")} />
  <article>
    <header class="post-header">
      <div class="post-meta">
        <p class="post-date tabular-nums">{formattedDate}</p>
        {/*
          Opens the system share sheet where there is one (phones, Safari);
          elsewhere copies the link and confirms with the same check as the
          code-block copy buttons.
        */}
        <button type="button" class="copy-btn share-btn" aria-label="Share" data-title={title}>
          <span class="copy-icon-default"><Icon name="share" size={18} /></span>
          <span class="copy-icon-check"><Icon name="check" size={18} /></span>
        </button>
      </div>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  {hn && (
    <section class="hn-comments" data-hn-id={hn} aria-labelledby="hn-title">
      <h2 class="hn-title" id="hn-title">
        <a href={`https://news.ycombinator.com/item?id=${hn}`}>Discuss on Hacker News</a>
      </h2>
    </section>
  )}
</SiteLayout>

<style>
  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  /* The copy button's look, but sitting in the row instead of pinned to a corner.
     The negative margin keeps the 44px tap target without pushing the row taller
     or the glyph off the column's right edge. */
  .share-btn {
    position: static;
    margin: calc((var(--tap-target-min) - 18px) / -2);
  }

  .post-date {
    font-family: var(--font-ui);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    margin: 0;
  }
</style>

<script>
  import { initDesmos } from "../lib/desmos";
  initDesmos();

  import { initHnComments } from "../lib/hn-comments";
  initHnComments();

  import { icons } from "../lib/icons";

  function buildButton(label: string) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.setAttribute("aria-label", label);
    btn.innerHTML = `
      <svg class="copy-icon-default" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons.copy}</svg>
      <svg class="copy-icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons.check}</svg>
    `;
    return btn;
  }

  function wireCopy(container: Element, label: string, getText: () => string) {
    const btn = buildButton(label);
    container.appendChild(btn);
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(getText().trim());
        btn.dataset.copied = "true";
        btn.setAttribute("aria-label", "Copied");
        setTimeout(() => {
          delete btn.dataset.copied;
          btn.setAttribute("aria-label", label);
        }, 1500);
      } catch {
        // Clipboard API unavailable (e.g. insecure context) — silently no-op.
      }
    });
  }

  const share = document.querySelector<HTMLButtonElement>(".share-btn");
  share?.addEventListener("click", async () => {
    const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? location.href;
    const data = { title: share.dataset.title, url };
    if (navigator.share && navigator.canShare?.(data) !== false) {
      try {
        await navigator.share(data);
      } catch {
        // Dismissing the sheet rejects too — nothing to do either way.
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      share.dataset.copied = "true";
      share.setAttribute("aria-label", "Link copied");
      setTimeout(() => {
        delete share.dataset.copied;
        share.setAttribute("aria-label", "Share");
      }, 1500);
    } catch {
      // Clipboard API unavailable (e.g. insecure context) — silently no-op.
    }
  });

  document.querySelectorAll(".prose pre").forEach((pre) => {
    wireCopy(pre, "Copy code", () => pre.querySelector("code")?.textContent ?? pre.textContent ?? "");
  });

  document.querySelectorAll(".prose .katex-display").forEach((mathEl) => {
    wireCopy(mathEl, "Copy formula", () => mathEl.querySelector("annotation")?.textContent ?? "");
  });
</script>
