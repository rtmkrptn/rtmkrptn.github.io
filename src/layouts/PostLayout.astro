---
import SiteLayout from "./SiteLayout.astro";
import "../styles/prose.css";

interface Props {
  title: string;
  description: string;
  date: Date;
}

const { title, description, date } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<SiteLayout title={`${title} — Artemii Karapetian`} description={description}>
  <article>
    <header class="post-header">
      <p class="post-date tabular-nums">{formattedDate}</p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</SiteLayout>

<style>
  .post-date {
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    margin-bottom: var(--space-1);
  }
</style>
