---
/*
  Private portfolio page.

  CV / portfolio content, from the profile dossier.

  Privacy, in two independent layers:
    1. Search exclusion — <meta robots noindex,nofollow> below, plus this route
       is filtered out of the sitemap in astro.config.mjs (same as /styleguide).
       Not linked from anywhere (nav, home, posts), so nothing points a crawler
       at it either.
    2. Password gate — a client-side ("for now, js") lock. The entered password
       is SHA-256'd and compared to a stored digest, so the literal password is
       not sitting in the source. IMPORTANT: this gates *display*, not *access*.
       Anything rendered below the gate still ships inside this HTML, so once
       real content is added, a reader can see it via view-source regardless of
       the password. Treat this as "keep it out of search + a soft lock"; it is
       not real access control. For that, the content has to not be sent until
       the server has authenticated the request.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Portfolio" description="Private.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  {/* Reveal an already-unlocked session before first paint, so a returning
      visitor never sees the gate flash. Runs in <head>, before <body> parses. */}
  <script is:inline slot="head">
    try {
      if (sessionStorage.getItem("pf-unlocked") === "1") {
        document.documentElement.classList.add("is-unlocked");
      }
    } catch (e) {
      /* private mode / blocked storage — fall through to the locked gate */
    }
  </script>

  {/* ========================= Lock gate ========================= */}
  <section id="pf-gate" class="pf-gate" aria-label="Password required">
    <form id="pf-form" class="pf-card panel" novalidate>
      <p class="pf-sub">Enter the password to continue.</p>

      <label class="pf-field">
        <span class="visually-hidden">Password</span>
        <input
          id="pf-input"
          class="input"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="Password"
          autofocus
        />
      </label>

      <button id="pf-submit" class="btn" type="submit">Unlock</button>

      <noscript>
        <p class="pf-sub">This page needs JavaScript to unlock.</p>
      </noscript>
    </form>
  </section>

  {/* ===================== Protected content =====================
      Ordered by weight: identity, qualifications, flagship research, projects,
      the EPQ, then the lighter material. Facts are from the profile dossier
      (19 Oct 2026); A2 grades are predicted, not achieved. */}
  <main id="pf-content" class="pf-content" tabindex="-1" aria-label="Portfolio">
    <div class="reading-column cv">
      <header class="cv-head">
        <h1 class="text-letterpress">Artemii Karapetian</h1>
        <p class="cv-lede">
          Applying for BSc Mathematics / Computer Science, September 2027 entry.
        </p>
        <p class="cv-meta">
          Athens, Greece ·
          <a href="mailto:rtmkrptn@gmail.com">rtmkrptn@gmail.com</a> ·
          <a href="https://github.com/rtmkrptn">github.com/rtmkrptn</a> ·
          <a href="https://rtmkrptn.github.io">rtmkrptn.github.io</a>
        </p>
      </header>

      <section class="cv-section" aria-labelledby="cv-edu">
        <h2 id="cv-edu" class="cv-h">Education</h2>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Byron College, Athens</h3>
            <span class="cv-when">2025 – 2027</span>
          </div>
          <p class="cv-sub">Pearson Edexcel International A-Level, final year 2026–27 · results August 2027</p>
          <table class="cv-table">
            <thead>
              <tr><th scope="col">Subject</th><th scope="col">AS (achieved)</th><th scope="col">A2 (predicted)</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Mathematics</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Further Mathematics</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Computer Science</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Extended Project (EPQ)</th><td>A</td><td>—</td></tr>
            </tbody>
          </table>
          <p class="cv-note">
            Predicted grades are school-certified (Byron College, October 2026) and will be sat in June 2027.
            Mathematics and Further Mathematics cover six distinct units with no overlap.
          </p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>English</h3>
            <span class="cv-when">June 2026</span>
          </div>
          <p class="cv-sub">IELTS 7.5</p>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-research">
        <h2 id="cv-research" class="cv-h">Research</h2>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Discrete Layer Algebra</h3>
            <span class="cv-when">2026</span>
          </div>
          <p>
            An original algebraic theory of oriented, transparent, stacked layers, machine-verified in Lean 4.
            Begun from my own intuition about rotation of complex numbers and developed over many months.
          </p>
          <ul class="cv-list">
            <li>
              A canvas is a partial function P → F⊥ with a lossy override operator ⊔ (a left regular band with identity);
              position permutation is a lossless group action.
            </li>
            <li>
              A layer is a pair (canvas M, state g ∈ G), with g acting on positions through φ: G → Perm(P).
              Rendering loses exactly the state; stacking discards states and gives a semigroup without identity
              when G is non-trivial.
            </li>
            <li>
              Further results: a quotient isomorphic to a monoid of pictures, inflation and automorphism results,
              and D4 acting on the square.
            </li>
            <li>All results are formally proven in Lean 4, not argued informally.</li>
            <li>
              To do it I taught myself the group theory and the Lean toolchain needed to understand and verify every step.
            </li>
          </ul>
          <p class="cv-note">
            Authorship, disclosed: conceived and directed by me, developed with AI assistance, and credited as
            “Artemii Karapetian and Anthropic”. I supplied the idea and direction and judged and corrected the formal content.
          </p>
          <p class="cv-links">
            <a href="https://github.com/rtmkrptn/discrete-layer-algebra">Repository</a>
            <a href="https://rtmkrptn.github.io/discrete-layer-algebra">Interactive demo</a>
          </p>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-epq">
        <h2 id="cv-epq" class="cv-h">Extended Project Qualification</h2>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Non-random sampling in small local communities</h3>
            <span class="cv-when">Grade A</span>
          </div>
          <p>
            A statistics investigation built on an original survey of a heterogeneous population with clear,
            mutually exclusive groups. Simple random sampling was the baseline against which five sampling methods
            were compared on how well they estimated central tendency and spread, with Monte Carlo simulation
            drawing the samples.
          </p>
          <p>
            Both sub-hypotheses were falsified, for the same structural reason: each rested on an untested assumption.
            I expected quota sampling to distort the estimate most because its gender quota was unbalanced, but gender
            proved independent of opinion. I expected Neyman allocation to sit closest to the baseline, but its
            optimality theorem guarantees low variance, not proximity to a reference.
          </p>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-projects">
        <h2 id="cv-projects" class="cv-h">Projects</h2>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Smooth fractal explorer</h3>
            <a class="cv-when" href="https://rtmkrptn.github.io/make-your-fractal">Live</a>
          </div>
          <p>Recursion over complex numbers with automatic differentiation via dual numbers. Built with AI assistance.</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Layer algebra demo</h3>
            <a class="cv-when" href="https://rtmkrptn.github.io/discrete-layer-algebra">Live</a>
          </div>
          <p>Applies the research above: a puzzle solved by greedy best-first search in the space of layers. Built with AI assistance.</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Mathematical modelling</h3>
            <a class="cv-when" href="https://github.com/rtmkrptn/cool-math-things">Repository</a>
          </div>
          <p>Monte Carlo simulations, an Euler-method ODE solver and a few machine-learning algorithms.</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>XOR neural network</h3>
          </div>
          <p>Built and trained by hand in NumPy to learn the fundamentals of backpropagation.</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Desmos</h3>
          </div>
          <p>Recreational mathematics: complex numbers, linear maps, random variables, number theory.</p>
        </div>
        <p class="cv-note">
          Skills: I write Python (NumPy) and LaTeX myself, and direct AI-assisted development in TypeScript,
          WebGL2/GLSL and Lean 4.
        </p>
      </section>

      <section class="cv-section" aria-labelledby="cv-study">
        <h2 id="cv-study" class="cv-h">Self-study</h2>
        <ul class="cv-list">
          <li>
            <strong>DelftX Probability Theory</strong> (online), taken ahead of the Year 12 syllabus: random variables,
            and the notation and limitations of the Poisson, Bernoulli and Binomial distributions.
          </li>
          <li><strong>deep-ml.com</strong>, calculus for ML: 22 problems solved.</li>
          <li>
            <strong>Textbooks:</strong> Herstein, <em>Topics in Algebra</em>; Vinberg (algebra); Feder, <em>Fractals</em>;
            Stewart (multivariable calculus); <em>Statistics: A Very Short Introduction</em>.
          </li>
          <li><strong>UX/UI design:</strong> a one-year, 490-hour online course (2023) on user psychology, cognition and prototyping software logic.</li>
        </ul>
      </section>

      <section class="cv-section" aria-labelledby="cv-writing">
        <h2 id="cv-writing" class="cv-h">Writing and competitions</h2>
        <ul class="cv-list">
          <li>
            Blog post:
            <a href="https://rtmkrptn.github.io/posts/high-school-calculator-computes-analytical-number-theory">a prime-generating function with no <code>if</code>, <code>mod</code> or <code>gcd</code></a>.
          </li>
          <li>Senior UKMT (UK Mathematics Trust): participant, 2025 and 2026.</li>
        </ul>
      </section>

      <section class="cv-section" aria-labelledby="cv-more">
        <h2 id="cv-more" class="cv-h">Other</h2>
        <ul class="cv-list">
          <li>Volunteering for Breast Cancer Awareness Month: made ribbons (2026) and sold them (2025).</li>
          <li>
            Reading on design and startups: <em>What Makes Great Design</em>, <em>Laws of UX</em>, <em>SETTERS</em>,
            <em>Zero to One</em>; currently <em>Bauhaus</em> and <em>Design Is Storytelling</em>.
          </li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* ---- State toggle (class lives on <html>) ---- */
  #pf-content {
    display: none;
  }
  html.is-unlocked #pf-gate {
    display: none;
  }
  html.is-unlocked #pf-content {
    display: block;
  }

  /* ---- Lock gate ---- */
  #pf-gate.pf-gate {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .pf-card {
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  /* Even padding on all four sides; beats .panel's regardless of load order. */
  #pf-gate .pf-card {
    padding: var(--space-7);
  }

  .pf-sub {
    margin: 0 0 var(--space-5) 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }

  .pf-field {
    width: 100%;
    margin: 0 0 var(--space-4) 0;
  }

  #pf-gate .btn {
    width: 100%;
  }

  /*
    Wrong password turns the field red — a red ring in place of the blue focus
    one, plus a red border. There is no text message: the password is either
    right or wrong, and the red says so on its own. Cleared the instant the
    field is edited (see the input handler in the script).
  */
  .pf-card.is-wrong .input {
    border-color: var(--red-glossy-dark);
    box-shadow: var(--shadow-inset-track), 0 0 0 2px var(--red-glossy);
  }
  .pf-card.is-wrong .input:focus-visible,
  .pf-card.is-wrong .input:focus {
    outline: none;
  }

  .pf-card.is-wrong {
    animation: pf-shake var(--duration-fast) var(--ease-standard);
  }

  /* ---- Content ---- */
  #pf-content:focus {
    outline: none;
  }

  .pf-content {
    padding-block: var(--space-section-mobile);
  }

  html.is-unlocked .pf-content {
    animation: pf-reveal var(--duration-reveal) var(--ease-decelerate);
  }

  /* ---- CV ---- */
  .cv-head {
    margin-bottom: var(--space-9);
  }
  .cv-lede {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
  }
  .cv-meta {
    margin: var(--space-2) 0 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }
  .cv-section {
    margin-bottom: var(--space-9);
  }
  .cv-h {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-separator);
    font-family: var(--font-ui);
    font-size: var(--font-size-chrome);
    font-weight: 600;
    letter-spacing: var(--letter-spacing-kicker);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .cv-item {
    margin-bottom: var(--space-6);
  }
  .cv-item p,
  .cv-list {
    margin: var(--space-2) 0 0;
  }
  .cv-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--space-4);
  }
  .cv-row h3 {
    font-size: var(--font-size-h3-mobile);
  }
  .cv-when {
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  a.cv-when {
    color: var(--color-accent-solid);
  }
  .cv-sub,
  .cv-note {
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }
  .cv-list {
    padding-left: var(--space-5);
    list-style: disc;
  }
  .cv-list li + li {
    margin-top: var(--space-2);
  }
  .cv-links {
    display: flex;
    gap: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
  }
  .cv-table {
    width: 100%;
    margin-top: var(--space-3);
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
  }
  .cv-table th,
  .cv-table td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--color-separator);
  }
  .cv-table thead th {
    color: var(--color-text-secondary);
  }
  .cv-table tbody th {
    color: var(--color-text);
  }

  @media print {
    .cv-section {
      break-inside: avoid;
    }
  }

  @media (min-width: 768px) {
    .pf-content {
      padding-block: var(--space-section-desktop);
    }
  }

  @keyframes pf-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(4px);
    }
  }

  @keyframes pf-reveal {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-card.is-wrong,
    html.is-unlocked .pf-content {
      animation: none;
    }
  }
</style>

<script>
  /*
    Client-side gate. The password is never stored in source — only the SHA-256
    digest of it is, and the entered value is hashed and compared. See the note
    at the top of this file for why this guards display, not access.
  */
  const DIGEST = "1ded682b0c236a7f95479c065ac1a8d400fbcef44ea582d82687d1175c0060c7";

  const root = document.documentElement;
  const form = document.getElementById("pf-form") as HTMLFormElement | null;
  const input = document.getElementById("pf-input") as HTMLInputElement | null;
  // The form element itself carries the .pf-card class, so the wrong-password
  // state (red field + shake) is toggled directly on it.
  const card = form;
  const content = document.getElementById("pf-content");

  async function sha256Hex(text: string): Promise<string> {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  function unlock(persist: boolean) {
    root.classList.add("is-unlocked");
    if (persist) {
      try {
        sessionStorage.setItem("pf-unlocked", "1");
      } catch (e) {
        /* storage blocked — the page stays unlocked for this view regardless */
      }
    }
    // Move focus into the revealed content so keyboard users land in the page.
    content?.focus();
  }

  function reject() {
    // The red field plus the shake is the whole message — no text is shown.
    card?.classList.remove("is-wrong");
    // Reflow so the animation restarts on repeated wrong attempts.
    void card?.offsetWidth;
    card?.classList.add("is-wrong");
    input?.select();
  }

  // Clear the red state as soon as the visitor edits the field.
  input?.addEventListener("input", () => {
    card?.classList.remove("is-wrong");
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const value = input?.value ?? "";
    if (!value) {
      reject();
      return;
    }
    try {
      const hex = await sha256Hex(value);
      if (hex === DIGEST) {
        unlock(true);
      } else {
        reject();
      }
    } catch (e) {
      // SubtleCrypto needs a secure context (https or localhost). If it is
      // unavailable we cannot verify, so treat it as a failed attempt.
      console.warn("Password check unavailable (needs https):", e);
      reject();
    }
  });

  // Focus the field on load when still locked (autofocus does not fire for
  // elements that scripts may have hidden, and skips an already-unlocked view).
  if (!root.classList.contains("is-unlocked")) input?.focus();
</script>
