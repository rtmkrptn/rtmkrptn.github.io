---
/*
  Private portfolio page.

  CV / portfolio content, from the profile dossier.

  Privacy, in two independent layers:
    1. Search exclusion — <meta robots noindex,nofollow> below, plus this route
       is filtered out of the sitemap in astro.config.mjs (same as /styleguide).
       Not linked from anywhere (nav, home, posts), so nothing points a crawler
       at it either.
    2. Password gate — a client-side ("for now, js") lock. The entered password
       is SHA-256'd and compared to a stored digest, so the literal password is
       not sitting in the source. IMPORTANT: this gates *display*, not *access*.
       Anything rendered below the gate still ships inside this HTML, so once
       real content is added, a reader can see it via view-source regardless of
       the password. Treat this as "keep it out of search + a soft lock"; it is
       not real access control. For that, the content has to not be sent until
       the server has authenticated the request.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import DesktopNav from "../components/DesktopNav.astro";
---

<BaseLayout title="Portfolio" description="Private.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  {/*
    Unlock survives in-session navigation but not a refresh. Runs in <head>,
    before <body> paints, so an already-unlocked page never flashes the gate.
      - A reload always re-locks (clears the flag), so refreshing asks again.
      - Any other arrival (a link, back/forward) reveals the content if this tab
        unlocked it earlier. sessionStorage is per-tab and dies with the tab, so
        a closed-and-reopened tab starts locked too.
  */}
  <script is:inline slot="head">
    try {
      var entry = performance.getEntriesByType("navigation")[0];
      if (entry && entry.type === "reload") {
        sessionStorage.removeItem("pf-unlocked");
      } else if (sessionStorage.getItem("pf-unlocked") === "1") {
        document.documentElement.classList.add("is-unlocked");
      }
    } catch (e) {
      /* blocked storage or no timing API — fall through to the locked gate */
    }
  </script>
  {/* ========================= Lock gate ========================= */}
  <section id="pf-gate" class="pf-gate" aria-label="Password required">
    <form id="pf-form" class="pf-card panel" novalidate>
      <p class="pf-sub">Enter the password to continue.</p>

      <label class="pf-field">
        <span class="visually-hidden">Password</span>
        <input
          id="pf-input"
          class="input"
          type="text"
          name="password"
          autocomplete="off"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          placeholder="Password"
          autofocus
        />
      </label>

      <button id="pf-submit" class="btn" type="submit">Unlock</button>

      <noscript>
        <p class="pf-sub">This page needs JavaScript to unlock.</p>
      </noscript>
    </form>
  </section>

  {/* The site nav, shown over the gate as well as the unlocked page, so the
      lock screen itself offers the way out (Home) — no separate back link. A
      sibling of the content, not a child, so the content's reveal transform
      never becomes its positioning context. */}
  <DesktopNav />

  {/* ===================== Protected content =====================
      Written for The Academy SF (proof of work over grades): what I have built
      comes first, then self-directed learning, then qualifications. Facts are from the profile dossier
      (19 Oct 2026); A2 grades are predicted, not achieved. */}
  <main id="pf-content" class="pf-content" tabindex="-1" aria-label="Portfolio">
    <div class="reading-column cv">
      <header class="cv-head">
        <h1 class="text-letterpress">Artemii Karapetian</h1>
        <p class="cv-lede">
          I build mathematical theory and the software that makes it visible: a Lean 4–verified algebra of layers,
          a fractal sandbox, and original statistical research.
        </p>
        <p class="cv-meta">
          Athens, Greece ·
          <a href="mailto:rtmkrptn@gmail.com">rtmkrptn@gmail.com</a> ·
          <a href="https://github.com/rtmkrptn">github.com/rtmkrptn</a>
        </p>
      </header>

      <section class="cv-section" aria-labelledby="cv-work">
        <h2 id="cv-work" class="cv-h">What I have built</h2>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Algebraic theory of oriented transparent layers</h3>
          </div>
          <figure class="cv-media cv-media-lead">
            <img src="/portfolio/layer-structure-map.png" alt="Map of the structures in the theory: layers, canvases, and the maps between them" width="2000" height="1097" loading="lazy" decoding="async" />
          </figure>
          <figure class="cv-media">
            <img src="/portfolio/layer-overdraw.png" alt="Two canvases A and B and their override A ⊔ B" width="2000" height="654" loading="lazy" decoding="async" />
          </figure>
          <p>
            An original algebraic theory of oriented, transparent, stacked layers, machine-verified in Lean 4.
            Begun in winter 2026 from my own intuition about rotation of complex numbers and developed over many months,
            on breaks and in free periods. I taught myself group theory and Lean 4 to formalise it.
          </p>
          <ul class="cv-list">
            <li>
              A canvas is a partial function P → F⊥ with a lossy override operator ⊔ (a left regular band with identity);
              position permutation is a lossless group action.
            </li>
            <li>
              A layer is a pair (canvas M, state g ∈ G), with g acting on positions through φ: G → Perm(P).
              Rendering loses exactly the state; stacking discards states and gives a semigroup without identity
              when G is non-trivial.
            </li>
            <li>
              Further results: a quotient isomorphic to a monoid of pictures, inflation and automorphism results,
              and D4 acting on the square.
            </li>
            <li>All results are formally proven in Lean 4, not argued informally.</li>
            <li>
              External review: I sent an early version of the paper to Prof. Nathan Carter (Bentley University, author of
              <em>Visual Group Theory</em>). On a first reading he replied that it had “absolutely zero typos, grammar
              mistakes, or mathematical errors” and accurately captured the ideas. He suggested extending it to
              sliding-scale transparency (blend modes). The theory has developed since that version.
            </li>
            <li>
              Mentor: Mikhail Goubko, informally, as a research guide on what to read and where to tighten or expand.
              The paper is in final edits; an arXiv preprint will follow.
            </li>
          </ul>
          <p class="cv-note">
            Authorship, disclosed: conceived and directed by me, developed with AI assistance, and credited as
            “Artemii Karapetian and Anthropic”. I supplied the idea and direction and judged and corrected the formal content.
          </p>
          <figure class="cv-media">
            <img src="/portfolio/layer-d4-orbit.png" alt="The orbit of a picture under the dihedral group D4" width="2000" height="1089" loading="lazy" decoding="async" />
          </figure>
          <p>
            Application: a solver for the puzzle <em>Color Code</em> (SmartGames). Given a target picture and a fixed set
            of transparent tiles, it finds which tiles to stack, how to rotate them and in what order. It runs a greedy
            best-first search over a composite similarity measure, with no pretrained model and no per-target training.
            Built with AI assistance.
          </p>
          <figure class="cv-media">
            <video
              src="/portfolio/layer-demo.mp4"
              poster="/portfolio/layer-demo-poster.jpg"
              aria-label="Screen recording of the puzzle solver finding a stack of tiles"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"></video>
          </figure>
          <p class="cv-links">
            <a href="https://rtmkrptn.github.io/discrete-layer-algebra">Try it here</a>
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Web-based smooth fractal sandbox</h3>
          </div>
          <figure class="cv-media cv-media-lead">
            <video
              src="/portfolio/fractal-explorer.mp4"
              poster="/portfolio/fractal-explorer-poster.jpg"
              aria-label="Screen recording of the fractal sandbox in use"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"></video>
          </figure>
          <p>
            A sandbox for iterating any recursion over the complex plane: you write the iteration step, the escape
            condition and the starting value yourself, drag the constant c, and set the iteration count and palette.
            Julia and Mandelbrot sets are just two of the presets. Zoom and pan smoothly, and export a PNG.
            Automatic differentiation via dual numbers. Built with AI assistance.
          </p>
          <div class="cv-grid">
            <img src="/portfolio/fractal-explorer-1.jpg" alt="Fractal render" width="1600" height="1187" loading="lazy" decoding="async" />
            <img src="/portfolio/fractal-explorer-2.jpg" alt="Fractal render" width="1600" height="1032" loading="lazy" decoding="async" />
            <img src="/portfolio/fractal-explorer-3.jpg" alt="Fractal render" width="1600" height="1032" loading="lazy" decoding="async" />
            <img src="/portfolio/fractal-explorer-4.jpg" alt="Fractal render" width="1600" height="1032" loading="lazy" decoding="async" />
          </div>
          <p class="cv-links">
            <a href="https://rtmkrptn.github.io/make-your-fractal">Try it here</a>
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Non-random sampling in small local communities</h3>
          </div>
          <p>
            Extended Project Qualification, graded A. A statistics investigation built on an original survey of a heterogeneous population with clear,
            mutually exclusive groups. Simple random sampling was the baseline against which five sampling methods
            were compared on how well they estimated central tendency and spread, with Monte Carlo simulation
            drawing the samples.
          </p>
          <p>
            Both sub-hypotheses were falsified, for the same structural reason: each rested on an untested assumption.
            I expected quota sampling to distort the estimate most because its gender quota was unbalanced, but gender
            proved independent of opinion. I expected Neyman allocation to sit closest to the baseline, but its
            optimality theorem guarantees low variance, not proximity to a reference.
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Minecraft reinforcement-learning agent</h3>
          </div>
          <p>
            A working Fabric mod for Minecraft 1.20.1 that spawns a learning bot driven by continual (lifetime)
            reinforcement learning with internal behaviour state. It runs in-game and logs the agent’s live state:
            steps, HP and a “panic” signal. Written directly in Java.
          </p>
          <figure class="cv-media">
            <video
              src="/portfolio/minecraft-rl.mp4"
              poster="/portfolio/minecraft-rl-poster.jpg"
              aria-label="Screen recording of the mod running in Minecraft"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"></video>
          </figure>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Stochastic market simulator</h3>
          </div>
          <p>
            A geometric Brownian motion price path, pₜ = pₜ₋₁·exp(drift + Gaussian shock), with regime-switching drift
            and volatility, and an N-day moving average of returns plotted beneath. Regimes are shaded: green for an
            uptrend, red for a downtrend and blue for a crisis, when volatility spikes and the returns average swings
            far more. Animated step by step with Desmos’s tick action.
          </p>
          <div class="cv-grid cv-grid-fit">
            <img src="/portfolio/market-1.jpg" alt="A simulated price path with shaded regimes" width="1800" height="1200" loading="lazy" decoding="async" />
            <img src="/portfolio/market-2.jpg" alt="Another simulated price path, with a crisis regime in blue" width="1200" height="800" loading="lazy" decoding="async" />
          </div>
          <p class="cv-links">
            <a href="https://www.desmos.com/calculator/zjskflmhw4">Try it here</a>
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>p-trigonometry</h3>
          </div>
          <p>
            Trigonometry generalised to the Lₚ unit circle: sine- and cosine-like functions defined as the coordinates
            of a point traversing the p-norm unit “circle” (a squircle when p &gt; 2), with the complex-plane
            construction cos x + i·sin x and the rounded, flattened waves that result. Recreational mathematics on how
            trigonometry changes when the norm does.
          </p>
          <figure class="cv-media">
            <img src="/portfolio/ptrig-cropped.jpg" alt="The p-norm unit circle with the sine- and cosine-like waves traced from it" width="1200" height="570" loading="lazy" decoding="async" />
          </figure>
          <p class="cv-links">
            <a href="https://www.desmos.com/calculator/rbxouw3cyk">Try it here</a>
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-row">
            <h3>Mathematical modelling</h3>
          </div>
          <p>Monte Carlo simulations, an Euler-method ODE solver and a few machine-learning algorithms.</p>
          <p class="cv-links">
            <a href="https://github.com/rtmkrptn/cool-math-things">See the code</a>
          </p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>XOR neural network</h3>
          </div>
          <p>Built and trained by hand in NumPy, with no framework, to learn backpropagation from first principles.</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Recreational Desmos</h3>
          </div>
          <p>Complex numbers, linear maps, random variables, number theory.</p>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-writing">
        <h2 id="cv-writing" class="cv-h">Writing</h2>
        <div class="cv-item">
          <h3>
            <a href="https://rtmkrptn.github.io/posts/high-school-calculator-computes-analytical-number-theory">A prime-generating function without if, mod or gcd</a>
          </h3>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-edu">
        <h2 id="cv-edu" class="cv-h">Education</h2>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Byron College, Athens</h3>
            <span class="cv-when">2025 – 2027</span>
          </div>
          <p class="cv-sub">Pearson Edexcel International A-Level, final year 2026–27 · results August 2027</p>
          <table class="cv-table">
            <thead>
              <tr><th scope="col">Subject</th><th scope="col">AS (achieved)</th><th scope="col">A2 (predicted)</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Mathematics</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Further Mathematics</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Computer Science</th><td>A</td><td>A*</td></tr>
              <tr><th scope="row">Extended Project (EPQ)</th><td>A</td><td>—</td></tr>
            </tbody>
          </table>
          <p class="cv-note">
            Predicted grades are school-certified (Byron College, October 2026) and will be sat in June 2027.
            Mathematics and Further Mathematics cover six distinct units with no overlap.
          </p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>English</h3>
            <span class="cv-when">June 2026</span>
          </div>
          <p class="cv-sub">IELTS 7.5</p>
        </div>
        <div class="cv-item">
          <div class="cv-row">
            <h3>Senior UKMT (UK Mathematics Trust)</h3>
            <span class="cv-when">2025, 2026</span>
          </div>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-skills">
        <h2 id="cv-skills" class="cv-h">Technical skills</h2>
        <p>
          I write Python (NumPy) and LaTeX myself, and direct AI-assisted development in TypeScript,
          WebGL2/GLSL and Lean 4.
        </p>
      </section>

      <section class="cv-section" aria-labelledby="cv-study">
        <h2 id="cv-study" class="cv-h">Self-directed learning</h2>
        <ul class="cv-list">
          <li>
            DelftX Probability Theory (online), taken ahead of the Year 12 syllabus: random variables,
            and the notation and limitations of the Poisson, Bernoulli and Binomial distributions.
          </li>
          <li>deep-ml.com, calculus for ML: 22 problems solved.</li>
          <li>
            Textbooks: Herstein, <em>Topics in Algebra</em>; Vinberg (algebra); Feder, <em>Fractals</em>;
            Stewart (multivariable calculus); <em>Statistics: A Very Short Introduction</em>.
          </li>
          <li>UX/UI design: a one-year, 490-hour online course (2023) on user psychology, cognition and prototyping software logic.</li>
        </ul>
      </section>

      <section class="cv-section" aria-labelledby="cv-more">
        <h2 id="cv-more" class="cv-h">Other</h2>
        <ul class="cv-list">
          <li>Volunteering for Breast Cancer Awareness Month: made ribbons (2026) and sold them (2025).</li>
          <li>
            Reading on design and startups: <em>What Makes Great Design</em>, <em>Laws of UX</em>, <em>SETTERS</em>, <em>Zero to One</em>; currently <em>Bauhaus</em> and <em>Design Is Storytelling</em>.
          </li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* ---- State toggle (class lives on <html>) ---- */
  #pf-content {
    display: none;
  }
  html.is-unlocked #pf-gate {
    display: none;
  }
  html.is-unlocked #pf-content {
    display: block;
  }

  /* ---- Lock gate ---- */
  #pf-gate.pf-gate {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .pf-card {
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  /* Even padding on all four sides; beats .panel's regardless of load order. */
  #pf-gate .pf-card {
    padding: var(--space-7);
  }

  .pf-sub {
    margin: 0 0 var(--space-5) 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-small);
    color: var(--color-text-secondary);
  }

  .pf-field {
    width: 100%;
    margin: 0 0 var(--space-4) 0;
  }

  #pf-gate .btn {
    width: 100%;
  }

  /*
    Wrong password turns the field red — a red ring in place of the blue focus
    one, plus a red border. There is no text message: the password is either
    right or wrong, and the red says so on its own. Cleared the instant the
    field is edited (see the input handler in the script).
  */
  .pf-card.is-wrong .input {
    border-color: var(--red-glossy-dark);
    box-shadow: var(--shadow-inset-track), 0 0 0 2px var(--red-glossy);
  }
  .pf-card.is-wrong .input:focus-visible,
  .pf-card.is-wrong .input:focus {
    outline: none;
  }

  .pf-card.is-wrong {
    animation: pf-shake var(--duration-fast) var(--ease-standard);
  }

  /* ---- Content ---- */
  #pf-content:focus {
    outline: none;
  }

  /* A raised white sheet like the article pages — the content sits on a
     surface over the page's grey ground, not directly on it. The bottom
     padding clears the fixed nav, which sits at the bottom on phones. */
  .pf-content {
    min-height: 100vh;
    min-height: 100svh;
    background: var(--gradient-surface);
    padding-block: var(--space-8)
      calc(var(--nav-height-compact) + var(--space-5) + env(safe-area-inset-bottom, 0px));
  }

  html.is-unlocked .pf-content {
    animation: pf-reveal var(--duration-reveal) var(--ease-decelerate);
  }

  /* ---- CV ---- */
  /*
    Same type and rhythm as the article pages (prose.scss): 16/18px text, the
    site's own h2/h3 sizes, 24px between blocks, 8px between list items, 48px
    above a heading. Secondary lines sit one step below the text.
  */
  /* The size goes on the children, not on .cv itself: .cv is the reading column,
     whose 68ch width is measured in its own font size. Shrinking that would make
     the column narrower than every other page's and knock it off the shared grid. */
  .cv {
    --cv-small: 14px;
  }
  .cv > * {
    font-size: var(--font-size-prose-mobile);
  }
  .cv h2,
  .cv h3 {
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-display);
  }
  @media (min-width: 768px) {
    .cv {
      --cv-small: 16px;
    }
    .cv > * {
      font-size: var(--font-size-prose-desktop);
    }
  }
  .cv-head {
    margin-bottom: var(--space-10);
  }
  .cv-lede {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
  }
  .cv-meta {
    margin: var(--space-4) 0 0;
    font-family: var(--font-ui);
    font-size: var(--cv-small);
    color: var(--color-text-secondary);
  }
  /* Air carries the structure, not rules or boxes. */
  .cv-section {
    margin-bottom: var(--space-10);
  }
  .cv-h {
    margin-bottom: var(--space-6);
  }
  .cv-item {
    margin-bottom: var(--space-9);
  }
  .cv-item:last-child {
    margin-bottom: 0;
  }
  .cv-item p,
  .cv-list {
    margin: var(--space-4) 0 0;
  }
  .cv-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--space-4);
  }
  .cv-when {
    font-family: var(--font-ui);
    font-size: var(--cv-small);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .cv-sub,
  .cv-note {
    font-family: var(--font-ui);
    font-size: var(--cv-small);
    color: var(--color-text-secondary);
  }
  .cv-list {
    padding-left: var(--space-5);
    list-style: disc;
  }
  .cv-list li + li {
    margin-top: var(--space-2);
  }
  .cv-links {
    display: flex;
    gap: var(--space-6);
    font-family: var(--font-ui);
    font-size: var(--cv-small);
  }
  .cv-table {
    width: 100%;
    margin-top: var(--space-4);
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--cv-small);
  }
  .cv-table th,
  .cv-table td {
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    text-align: left;
    font-weight: 400;
    border-bottom: 1px solid var(--color-separator);
  }
  .cv-table thead th {
    color: var(--color-text-secondary);
  }
  .cv-table tbody th {
    color: var(--color-text);
  }

  .cv-media {
    margin: var(--space-6) 0 0;
  }
  .cv-media-lead {
    margin: var(--space-4) 0 var(--space-6);
  }
  .cv-media video,
  .cv-media img,
  .cv-grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: var(--border-hairline-width) solid var(--color-hairline);
    background: var(--color-separator);
  }
  .cv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .cv-grid img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .cv-grid-fit {
    align-items: center;
  }
  .cv-grid-fit img {
    aspect-ratio: auto;
    object-fit: contain;
  }

  @media print {
    .cv-section {
      break-inside: avoid;
    }
  }

  @media (min-width: 768px) {
    .pf-content {
      max-width: 1180px;
      margin-inline: auto;
      border-inline: var(--border-hairline-width) solid var(--color-hairline);
      box-shadow: var(--shadow-panel);
      /* On desktop the nav sits at the top, so the sheet clears it there. */
      padding-block: calc(var(--desktop-nav-height) + var(--space-7)) var(--space-10);
    }
  }

  @keyframes pf-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(4px);
    }
  }

  @keyframes pf-reveal {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-card.is-wrong,
    html.is-unlocked .pf-content {
      animation: none;
    }
  }
</style>

<script>
  /*
    Client-side gate. The password is never stored in source — only the SHA-256
    digest of it is, and the entered value is hashed and compared. See the note
    at the top of this file for why this guards display, not access.
  */
  const DIGEST = "1ded682b0c236a7f95479c065ac1a8d400fbcef44ea582d82687d1175c0060c7";

  const root = document.documentElement;
  const form = document.getElementById("pf-form") as HTMLFormElement | null;
  const input = document.getElementById("pf-input") as HTMLInputElement | null;
  // The form element itself carries the .pf-card class, so the wrong-password
  // state (red field + shake) is toggled directly on it.
  const card = form;
  const content = document.getElementById("pf-content");

  async function sha256Hex(text: string): Promise<string> {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest("SHA-256", bytes);
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
  }

  // Reveals the content and remembers it for this tab, so navigating around the
  // site and back does not ask again. A refresh and a closed tab both forget —
  // see the head script and sessionStorage's per-tab lifetime.
  function unlock() {
    root.classList.add("is-unlocked");
    try {
      sessionStorage.setItem("pf-unlocked", "1");
    } catch (e) {
      /* storage blocked — unlocked for this view regardless */
    }
    // Move focus into the revealed content so keyboard users land in the page.
    content?.focus();
  }

  function reject() {
    // The red field plus the shake is the whole message — no text is shown.
    card?.classList.remove("is-wrong");
    // Reflow so the animation restarts on repeated wrong attempts.
    void card?.offsetWidth;
    card?.classList.add("is-wrong");
    input?.select();
  }

  // Clear the red state as soon as the visitor edits the field.
  input?.addEventListener("input", () => {
    card?.classList.remove("is-wrong");
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const value = input?.value ?? "";
    if (!value) {
      reject();
      return;
    }
    try {
      const hex = await sha256Hex(value);
      if (hex === DIGEST) {
        unlock();
      } else {
        reject();
      }
    } catch (e) {
      // SubtleCrypto needs a secure context (https or localhost). If it is
      // unavailable we cannot verify, so treat it as a failed attempt.
      console.warn("Password check unavailable (needs https):", e);
      reject();
    }
  });

  // Screen recordings loop silently; with reduced motion they wait for a click instead.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLVideoElement>(".cv-media video").forEach((v) => {
      v.autoplay = false;
      v.pause();
      v.controls = true;
    });
  }

  // The page always loads locked now, so focus the field for immediate typing.
  input?.focus();
</script>
