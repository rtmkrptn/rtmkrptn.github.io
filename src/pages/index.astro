---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { withBase } from "../lib/base";
import { socialLinks } from "../data/social";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<SiteLayout title="Artemii Karapetian">
  <header class="hero">
    <div class="hero-identity">
      <h1 class="text-letterpress">Artemii Karapetian</h1>
      <ul class="social-row">
        {
          socialLinks.map((link) => (
            <li>
              <a
                class="social-link pressable"
                href={link.href}
                aria-label={link.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <BrandIcon name={link.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="tagline">Mathematics, Alife, ML.</p>
    <p class="bio">
      I write about mathematics, artificial life, and machine learning — mostly notes to
      myself that turned out legible enough to share.
    </p>
  </header>

  <section class="posts-section">
    <div class="track-list">
      <div class="track-list-header" aria-hidden="true">
        <span class="track-col track-col-sorted">Date</span>
        <span class="track-col">Title</span>
        <span class="track-col track-col-compact">Writing</span>
      </div>
      {
        posts.map((post) => (
          <a class="track-row" href={withBase(`/posts/${post.id}`)}>
            <span class="track-date">
              <span class="track-date-long">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
              <span class="track-date-short">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "2-digit",
                  month: "numeric",
                  day: "numeric",
                })}
              </span>
            </span>
            <span class="track-title">{post.data.title}</span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    margin-bottom: var(--space-section-mobile);
  }

  @media (min-width: 768px) {
    .hero {
      margin-bottom: var(--space-section-desktop);
    }
  }

  .tagline {
    font-family: var(--font-ui);
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }

  .bio {
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  /*
    Name and icons share one line. Wraps on narrow screens, where the icons
    drop below the name rather than squeezing it.
  */
  .hero-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-7);
    row-gap: var(--space-2);
  }

  .social-row {
    display: flex;
    gap: var(--space-2);
    /*
      .social-link is a 44px tap target around an 18px glyph, so the row is far
      taller than the icons look; these negative margins collapse that back.

      They are asymmetric on purpose. Centring on the flex line puts the icons
      on the name's cap-height centre, but the name's visual mass sits in the
      lowercase x-height band, which is lower — so true centring reads as
      riding high. The extra 4px on top drops them onto the text's optical
      centre. Margins still sum to -16px, so the line's height is unchanged.
    */
    margin-top: calc(var(--space-1) - var(--space-2));
    margin-bottom: calc(-1 * var(--space-1) - var(--space-2));
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    border-radius: 50%;
    color: var(--color-text-secondary);
  }

  .social-link:hover {
    color: var(--color-accent-solid);
    text-decoration: none;
  }

</style>
