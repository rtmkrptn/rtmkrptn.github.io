---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { withBase } from "../lib/base";
import { socialLinks } from "../data/social";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<SiteLayout title="Artemii Karapetian">
  <header class="hero">
    <h1 class="text-letterpress">Artemii Karapetian</h1>
    <p class="tagline">Mathematics, Alife, ML.</p>
    <p class="bio">
      I write about mathematics, artificial life, and machine learning — mostly notes to
      myself that turned out legible enough to share.
    </p>
    <ul class="social-row">
      {
        socialLinks.map((link) => (
          <li>
            <a
              class="social-link pressable"
              href={link.href}
              aria-label={link.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <BrandIcon name={link.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <section class="posts-section">
    <div class="list">
      {
        posts.map((post) => (
          <a class="list-row" href={withBase(`/posts/${post.id}`)}>
            <span class="post-date tabular-nums">
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </span>
            <span class="post-title">{post.data.title}</span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    margin-bottom: var(--space-section-mobile);
  }

  @media (min-width: 768px) {
    .hero {
      margin-bottom: var(--space-section-desktop);
    }
  }

  .tagline {
    font-family: var(--font-ui);
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }

  .bio {
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  .social-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-target-min);
    height: var(--tap-target-min);
    border-radius: 50%;
    color: var(--color-text-secondary);
  }

  .social-link:hover {
    color: var(--color-accent-solid);
    text-decoration: none;
  }

  .posts-section .list-row {
    align-items: flex-start;
  }

  .post-date {
    flex-shrink: 0;
    width: 7em;
    padding-top: 0.15em;
    font-family: var(--font-ui);
    color: var(--color-text-tertiary);
    font-size: var(--font-size-small);
  }

  .post-title {
    color: var(--color-text);
  }
</style>
