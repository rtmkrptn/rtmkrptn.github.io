---
import Icon from "./Icon.astro";
import { withBase } from "../lib/base";
import { navItems } from "../lib/nav";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string): boolean {
  const normalized = withBase(href).replace(/\/$/, "") || "/";
  return currentPath === normalized;
}
---

<nav class="tab-bar" aria-label="Primary">
  <ul class="tab-bar-list">
    {
      navItems.map((item) => (
        <li>
          <a
            class="tab-bar-link pressable"
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <Icon name={item.icon} size={22} />
            <span>{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../styles/mixins" as *;

  /* Spec: 49pt tall, glass/metal fill, 1px top border */
  .tab-bar {
    display: block;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    background-color: rgba(246, 247, 248, 0.88);
    background-image: var(--pattern-metal-striation);
    backdrop-filter: blur(12px) saturate(1.6);
    -webkit-backdrop-filter: blur(12px) saturate(1.6);
    border-top: var(--border-hairline-width) solid var(--color-hairline-strong);
    box-shadow: var(--shadow-inset-highlight);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  @media (min-width: 768px) {
    .tab-bar {
      display: none;
    }
  }

  .tab-bar-list {
    display: flex;
    min-height: 49px;
  }

  .tab-bar-list li {
    flex: 1;
  }

  .tab-bar-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--tap-target-min);
    padding: var(--space-1) 0;
    color: var(--graphite-500);
    text-shadow: var(--text-shadow-letterpress);
  }

  .tab-bar-link span {
    @include chrome-label(var(--font-size-tab-label));
  }

  .tab-bar-link[aria-current="page"] {
    color: var(--color-accent-solid);
  }
</style>
