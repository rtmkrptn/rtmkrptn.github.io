---
import { withBase } from "../lib/base";
import { navItems } from "../lib/nav";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string): boolean {
  const normalized = withBase(href).replace(/\/$/, "") || "/";
  return currentPath === normalized;
}
---

<header class="desktop-nav">
  <nav class="desktop-nav-bar" aria-label="Primary">
    {
      navItems.map((item) => (
        <a
          class="desktop-nav-segment"
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
      justify-content: center;
      position: sticky;
      top: 0;
      z-index: 10;
      padding: var(--space-2) var(--space-3);
      background-color: var(--color-paper);
      background-image: var(--pattern-pinstripe);
    }

    .desktop-nav-bar {
      display: flex;
      width: 100%;
      max-width: 760px;
      border-radius: var(--radius-surface);
      overflow: hidden;
      background: var(--gradient-chrome);
      border: var(--border-hairline-width) solid var(--color-chrome-border);
      box-shadow: var(--shadow-surface-raised), var(--shadow-inset-highlight);
    }

    .desktop-nav-segment {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 1;
      height: 44px;
      padding-inline: var(--space-3);
      color: var(--color-chrome-text);
      text-shadow: var(--text-shadow-on-chrome);
      font-size: var(--font-size-small);
      white-space: nowrap;
      text-decoration: none;
      box-shadow: inset -1px 0 0 var(--color-chrome-divider), inset -2px 0 0 var(--color-chrome-divider-highlight);
      transition: background var(--duration-fast) var(--ease-standard);
    }

    .desktop-nav-segment:last-child {
      box-shadow: none;
    }

    .desktop-nav-segment:hover {
      background: rgba(255, 255, 255, 0.08);
      text-decoration: none;
    }

    .desktop-nav-segment:active {
      background: rgba(0, 0, 0, 0.25);
    }

    .desktop-nav-segment[aria-current="page"] {
      background: var(--gradient-chrome-active);
      box-shadow: var(--shadow-chrome-active-inset);
    }

    .desktop-nav-segment[aria-current="page"]:hover {
      background: var(--gradient-chrome-active);
    }
  }
</style>
