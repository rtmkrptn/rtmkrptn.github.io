---
import { brandIcons, type BrandIconName } from "../lib/brand-icons";

interface Props {
  name: BrandIconName;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={brandIcons[name]} />
</svg>
